    "import seaborn as sns\n",
    "import matplotlib.pyplot as plt\n",
    "\n",
    "mpg = sns.load_dataset(\"mpg\")\n",
    "sns.scatterplot(data=mpg, x=\"horsepower\", y=\"mpg\", hue=\"origin\")\n",
    "plt.title(\"MPG vs Horsepower\")\n",
    "plt.show()\n"
   ]
  }
